BASE_URL=https://context-studio.example.com
# Base URL of the Context Studio UI application

API_BASE_URL=https://api.context-studio.example.com
# Base URL for all REST API calls

AUTH_USERNAME=your-w3-ibm-id@ibm.com
# IBM W3 intranet SSO username

AUTH_PASSWORD=your-w3-password
# IBM W3 intranet SSO password — never commit real value

DEFAULT_TIMEOUT=60000
# Default Playwright action/navigation timeout in milliseconds

INGESTION_POLL_TIMEOUT=300000
# Maximum wait time for async ingestion to complete (ms)
# 300000 = 5 minutes — increase for slow environments

INGESTION_POLL_INTERVAL=5000
# How often to poll ingestion status endpoint (ms)

JIRA_TEST_URL=https://jsw.ibm.com
# Jira instance URL for connector ingestion tests

JIRA_TEST_EMAIL=your-email@ibm.com
# Jira account email for authentication

JIRA_TEST_TOKEN=your-jira-api-token
# Jira API token for authentication

GIT_TEST_URL=https://github.com
# Git repository URL for connector ingestion tests

GIT_TEST_ORG=your-github-org
# GitHub organization name

GIT_TEST_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GitHub Personal Access Token for connector ingestion tests

SP_ENT_TEST_URL=https://your-org.sharepoint.com/sites/TestSite
# SharePoint Enterprise site URL for connector tests

SP_ENT_TEST_APP_ID=your-app-id
# SharePoint Enterprise App ID (Client ID)

SP_ENT_TEST_TOKEN=your-app-secret
# SharePoint Enterprise App Secret (Client Secret)

SP_ENT_TEST_TENANT_ID=your-tenant-id
# SharePoint Enterprise Tenant ID

GITHUB_TEST_PAT=ghp_xxxxxxxxxxxxxxxxxxxx
# GitHub Personal Access Token for connector ingestion tests
# Needs: repo read scope (fine-grained or classic)

SHAREPOINT_TEST_URL=https://your-org.sharepoint.com/sites/TestSite
# SharePoint site URL used in connector tests

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Slack incoming webhook for test run notifications
# Leave empty to disable Slack notifications

TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/...
# Microsoft Teams incoming webhook for test run notifications
# Leave empty to disable Teams notifications

LOG_LEVEL=info
# Winston log level: error | warn | info | debug
# Use debug for verbose output during local troubleshooting